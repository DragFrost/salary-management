# Local PostgreSQL Development Database URL
# Replace YOUR_PASSWORD with your local postgres user password
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/acme_salary

# Dedicated Test Database URL (MANDATORY for running Vitest integration tests)
# Tests are strictly prohibited from running against DATABASE_URL to protect seed data.
TEST_DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/acme_salary_test
